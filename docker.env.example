# DeepSOC Docker环境变量配置示例
# 复制此文件为 .env 进行本地开发或生产部署

# 数据库配置
# Docker环境中，主机名应指向数据库服务名（例如 mysql）
DATABASE_URL="mysql+pymysql://deepsoc_user:deepsoc_password@mysql:3306/deepsoc"


# 大模型配置
# 请在此处填写您的API密钥
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=deepseek-v3
LLM_MODEL_LONG_TEXT=qwen-long
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.6

# 应用配置
FLASK_APP=main.py
FLASK_ENV=development
SECRET_KEY=deepsoc_secret_key_change_in_production

# JWT配置
JWT_SECRET_KEY=deepsoc_jwt_secret_key_change_in_production
JWT_ACCESS_TOKEN_EXPIRES=86400

# SOAR配置
SOAR_API_URL=https://hg-auto.wuzhi-ai.com:18443
SOAR_API_TOKEN=your_soar_token_here
SOAR_API_TIMEOUT=30
SOAR_RETRY_COUNT=3
SOAR_RETRY_DELAY=5
SOAR_VERIFY_SSL=False

# 监听配置
LISTEN_HOST=0.0.0.0
LISTEN_PORT=5007

# 调试配置
DEBUG=true

# RabbitMQ Configuration
# Docker环境中，主机名应指向RabbitMQ服务名（例如 rabbitmq）
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/


# Expert Service Worker Intervals (seconds)
EXPERT_EXECUTION_SUMMARY_INTERVAL=10
EXPERT_COMMAND_STATUS_INTERVAL=10
EXPERT_TASK_STATUS_INTERVAL=15
EXPERT_EVENT_ROUND_STATUS_INTERVAL=20
EXPERT_EVENT_SUMMARY_INTERVAL=30
EXPERT_EVENT_NEXT_ROUND_INTERVAL=25
